{
  "id": "/",
  "name": "Trips",
  "short_name": "Trips",
  "description": "Plan a drive, optimise stops, open in Waze.",
  "lang": "en-AU",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "start_url": "/",
  "scope": "/",
  "orientation": "portrait",
  "background_color": "#F2F2F7",
  "theme_color": "#F2F2F7",
  "categories": ["navigation", "travel"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New trip",
      "short_name": "New trip",
      "url": "/?new=1",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ]
}
