# Google Cloud — enable Places API (New), Geocoding, Directions, Routes, Distance Matrix
# Routes API with TRAFFIC_AWARE is used for live ETAs and jam colours
GOOGLE_MAPS_API_KEY=

# Admin dashboard password — access at /admin.html
# Default is "trips-admin" (change this!)
ADMIN_PASS=trips-admin

# Optional — one AdSense display ad on first launch (public client/slot ids)
# ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# ADSENSE_SLOT=1234567890
